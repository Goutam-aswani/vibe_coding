# LinkedIn Automation Settings
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Browser Settings
HEADLESS=false
SLOW_MO=100  # milliseconds delay between actions

# Application Settings
MAX_RETRIES=3
TIMEOUT=30000  # milliseconds
RATE_LIMIT_DELAY=5  # seconds between applications

# File Paths
RESUME_PATH=./documents/resume.pdf
COVER_LETTER_PATH=./documents/cover_letter.pdf

# API Settings
API_HOST=127.0.0.1
API_PORT=8080

# Session Management
BROWSER_PROFILE_PATH=./browser_data
