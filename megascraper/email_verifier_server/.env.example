# Email Verifier API Environment Variables
# Copy this file to .env and configure your settings

# ============================================================================
# ⭐ NEW: AUTOMATIC COOKIE REFRESH (Recommended!)
# ============================================================================
# Set your check.emailverifier.online login credentials
# This enables automatic cookie refresh every 50 minutes
# No more manual cookie updates every hour!
#
# To use this feature:
# 1. Install dependencies: pip install playwright
# 2. Install browser: playwright install chromium
# 3. Set your credentials below
# 4. Start the server - cookies refresh automatically!

EMAILVERIFIER_EMAIL=your_email@example.com
EMAILVERIFIER_PASSWORD=your_password_here
COOKIE_REFRESH_INTERVAL=50
AUTO_REFRESH_COOKIE=true

# ============================================================================
# OR: Manual Cookie Management (Old Method)
# ============================================================================
# If you prefer manual cookie management, set this cookie value
# Get it from check.emailverifier.online after logging in
# WARNING: This expires every hour - use auto-refresh above instead!
#
# Instructions:
# 1. Visit: https://check.emailverifier.online/bulk-verify-email/index.php
# 2. Log in to your account
# 3. Open DevTools (F12) → Application → Cookies
# 4. Copy the PHPSESSID value and paste below

EMAILVERIFIER_SESSION_COOKIE=your_phpsessid_cookie_here


# ============================================================================
# OPTIONAL: Security
# ============================================================================
# If set, all API requests must include X-API-Key header with this value
# Leave empty for open access (not recommended for production)

API_KEY=


# ============================================================================
# Server Configuration
# ============================================================================

HOST=0.0.0.0
PORT=8000
WORKERS=4
DEBUG=false


# ============================================================================
# Rate Limiting
# ============================================================================
# Delay between verification requests (seconds)
RATE_LIMIT_DELAY=1.0

# Maximum concurrent verifications
MAX_CONCURRENT=5

# Request timeout (seconds)
REQUEST_TIMEOUT=30


# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
# Use "*" to allow all origins (not recommended for production)

CORS_ORIGINS=*


# ============================================================================
# Job Queue Configuration
# ============================================================================
# Maximum emails per background job
MAX_JOB_SIZE=10000

# Remove completed jobs after N hours
JOB_CLEANUP_HOURS=24


# ============================================================================
# Optional: Redis Configuration
# ============================================================================
# Redis URL for caching and persistent job queue
# Example: redis://localhost:6379/0

REDIS_URL=

# Cache TTL in seconds
CACHE_TTL=3600


# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
